# Metabase instance URL (no trailing slash)
METABASE_INSTANCE_URL=http://localhost:3000

# Email address of an existing Metabase user
METABASE_USER_EMAIL=analyst@example.com

# Password for the Metabase user
METABASE_USER_PASSWORD=

# Anthropic API key
ANTHROPIC_API_KEY=

# API key for the dashboard list service
X-API-KEY=

# Server port (default: 3001)
SERVER_PORT=3001

# Client dev-server port (default: 3100)
CLIENT_PORT=3100
